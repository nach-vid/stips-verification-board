# ==============================================================================
# Server Configuration
# ==============================================================================
PORT=3000
NODE_ENV=production

# ==============================================================================
# Firebase Firestore Database Configuration (Production & Cloud Hosting)
# Choose ONE of the following configuration options below:
# ==============================================================================

# OPTION 1 (Recommended for Cloud Hosting: Render, Railway, Vercel, Fly.io, Heroku):
# Paste the entire content of your serviceAccountKey.json as a single-line JSON string:
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project-id","private_key_id":"xxxxxxxxxx","private_key":"-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com","client_id":"000000000000000000000","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project-id.iam.gserviceaccount.com"}'

# OPTION 2 (Individual Environment Variables):
# If your deployment platform prefers individual key/value pairs:
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# OPTION 3 (Google Application Credentials Path):
# If running on a VM or container where the file is mounted to disk:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# NOTE: If none of the above are provided, the backend automatically uses an
# in-memory database mock so local development continues running safely.
